<Configuration>
  <VGpu>Disable</VGpu>
  <Networking>Default</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <PrinterRedirection>Disable</PrinterRedirection>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\Code\Rea\laravel-herd\kiln\spikes\windows-dns\sandbox\tools</HostFolder>
      <SandboxFolder>C:\spike\tools</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>D:\Code\Rea\laravel-herd\kiln\spikes\windows-dns\sandbox\results</HostFolder>
      <SandboxFolder>C:\spike\results</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
